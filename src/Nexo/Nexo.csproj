<Project Sdk="Microsoft.NET.Sdk">

  <!-- .NET Framework 4.8 viene con Windows 10 y 11: Nexo.exe funciona en cualquier PC sin instalar nada. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Nexo</AssemblyName>
    <RootNamespace>Nexo</RootNamespace>
    <ApplicationIcon>Nexo.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Product>Nexo</Product>
    <AssemblyTitle>Nexo</AssemblyTitle>
    <Version>1.0.0</Version>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nexo.Core\Nexo.Core.csproj" />
    <Resource Include="Nexo.ico" />
    <!-- Fotos reales de cada consola (Wikimedia Commons; créditos en el LEEME). -->
    <Resource Include="Photos\*.png" />
  </ItemGroup>

</Project>
