<Window x:Class="Nexo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nexo"
        Icon="Nexo.ico"
        WindowStyle="None"
        ResizeMode="CanMinimize"
        WindowState="Maximized"
        Background="#07080D"
        Foreground="{StaticResource Brush.Ink}"
        FontFamily="{StaticResource Font.Ui}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        MinWidth="960" MinHeight="600"
        Width="1440" Height="900">
  <Grid x:Name="Root" ClipToBounds="True">

    <!-- ================= Fondo: auroras con el color de la consola, partículas y viñeta ================= -->
    <Grid IsHitTestVisible="False">
      <Ellipse x:Name="AuroraA" Width="1500" Height="1500" HorizontalAlignment="Left" VerticalAlignment="Top"
               Margin="-560,-760,0,0" Opacity="0.6" RenderTransformOrigin="0.5,0.5">
        <Ellipse.RenderTransform>
          <TransformGroup><ScaleTransform x:Name="AuroraAScale"/><TranslateTransform x:Name="AuroraAMove"/></TransformGroup>
        </Ellipse.RenderTransform>
      </Ellipse>
      <Ellipse x:Name="AuroraB" Width="1600" Height="1600" HorizontalAlignment="Right" VerticalAlignment="Bottom"
               Margin="0,0,-700,-900" Opacity="0.36" RenderTransformOrigin="0.5,0.5">
        <Ellipse.RenderTransform>
          <TransformGroup><ScaleTransform x:Name="AuroraBScale"/><TranslateTransform x:Name="AuroraBMove"/></TransformGroup>
        </Ellipse.RenderTransform>
      </Ellipse>
      <!-- Arte del juego seleccionado: dos capas que se funden entre sí -->
      <Grid x:Name="GameArt" Opacity="0" ClipToBounds="True">
        <!-- Cada capa: un degradado con los colores del juego y la imagen (fondo HD o portada nítida) -->
        <Grid x:Name="GameArtA" Opacity="0" RenderTransformOrigin="0.5,0.5">
          <Grid.RenderTransform><ScaleTransform/></Grid.RenderTransform>
          <Rectangle/>
          <Image Stretch="UniformToFill"/>
        </Grid>
        <Grid x:Name="GameArtB" Opacity="0" RenderTransformOrigin="0.5,0.5">
          <Grid.RenderTransform><ScaleTransform/></Grid.RenderTransform>
          <Rectangle/>
          <Image Stretch="UniformToFill"/>
        </Grid>
        <Rectangle x:Name="GameArtDim" Fill="#07080D" Opacity="0.55"/>
        <Rectangle>
          <Rectangle.Fill>
            <RadialGradientBrush Center="0.5,0.42" GradientOrigin="0.5,0.42" RadiusX="0.75" RadiusY="0.8">
              <GradientStop Offset="0.45" Color="#0007080D"/>
              <GradientStop Offset="1" Color="#E607080D"/>
            </RadialGradientBrush>
          </Rectangle.Fill>
        </Rectangle>
      </Grid>
      <Rectangle x:Name="FloorGlow"/>
      <Rectangle>
        <Rectangle.Fill>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#3307080D"/>
            <GradientStop Offset="1" Color="#D907080D"/>
          </LinearGradientBrush>
        </Rectangle.Fill>
      </Rectangle>
      <Canvas x:Name="Particles"/>
    </Grid>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>   <!-- barra superior -->
        <RowDefinition Height="*"/>      <!-- carrusel de consolas -->
        <RowDefinition Height="Auto"/>   <!-- información -->
        <RowDefinition Height="Auto"/>   <!-- estantería de juegos -->
        <RowDefinition Height="Auto"/>   <!-- pie -->
      </Grid.RowDefinitions>

      <!-- ================= Barra superior ================= -->
      <Grid Grid.Row="0" Margin="40,20,28,0" x:Name="TopBar" Background="Transparent">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Path Data="M9,23 V9 L23,23 V9" Width="30" Height="30" Stretch="Uniform" StrokeThickness="3.4"
                StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                Stroke="{DynamicResource Brush.Accent}" Margin="0,0,12,0">
            <Path.Effect><DropShadowEffect x:Name="BrandGlow" BlurRadius="14" ShadowDepth="0" Opacity="0.8" Color="#7CF4FF"/></Path.Effect>
          </Path>
          <TextBlock Text="Nexo" FontSize="25" FontWeight="Bold" VerticalAlignment="Center"/>
          <TextBlock Text="Tus consolas y tus juegos, en un solo lugar" FontSize="14" Margin="14,4,0,0"
                     Foreground="{StaticResource Brush.InkFaint}" VerticalAlignment="Center" x:Name="Tagline"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <!-- Actualización automática: progreso de la descarga y cuenta atrás (B o Esc la deja para el cierre). -->
          <Button x:Name="UpdateChip" Visibility="Collapsed" Style="{StaticResource Button.Glass}" Padding="14,7" Margin="0,0,12,0"
                  BorderBrush="{DynamicResource Brush.Accent}" ToolTip="Actualización de Nexo">
            <StackPanel Orientation="Horizontal">
              <Path Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource Brush.Accent}" StrokeThickness="1.9" Margin="0,0,8,0"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M12,4 V15 M7,10 L12,15 L17,10 M5,20 H19"/>
              <TextBlock x:Name="UpdateText" FontSize="13" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <!-- Donar: discreto, abre Ko-fi en el navegador. Con mando, botón View (Back). -->
          <Button x:Name="DonateButton" Style="{StaticResource Button.Glass}" Padding="14,7" Margin="0,0,12,0"
                  ToolTip="Donar en Ko-fi (ko-fi.com/nova5emu)">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="☕" FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center"/>
              <TextBlock Text="Donar" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Brush.InkSoft}" VerticalAlignment="Center"/>
              <Border x:Name="DonateKey" Style="{StaticResource Kbd}" Margin="8,0,0,0" Visibility="Collapsed">
                <TextBlock Text="View" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Brush.InkSoft}"/>
              </Border>
            </StackPanel>
          </Button>
          <Border x:Name="GpuChip" Visibility="Collapsed" CornerRadius="999" Padding="14,7" Margin="0,0,12,0"
                  Background="{StaticResource Brush.Glass}" BorderBrush="{StaticResource Brush.Line}" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
              <Path Width="17" Height="17" Stretch="Uniform" Stroke="{DynamicResource Brush.Accent}" StrokeThickness="1.8" StrokeLineJoin="Round" Margin="0,0,8,0"
                    Data="M3,7 H21 V17 H3 Z M7,17 V20 M11,17 V20 M15,17 V20 M7,10 H11 V14 H7 Z M14,10 H18 M14,13 H18"/>
              <TextBlock x:Name="GpuText" FontSize="13" Foreground="{StaticResource Brush.InkSoft}"/>
            </StackPanel>
          </Border>
          <Border x:Name="PadChip" Visibility="Collapsed" CornerRadius="999" Padding="14,7" Margin="0,0,12,0"
                  Background="{StaticResource Brush.Glass}" BorderBrush="{StaticResource Brush.Line}" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
              <Path Width="18" Height="18" Stretch="Uniform" Fill="{DynamicResource Brush.Accent}" Margin="0,0,8,0"
                    Data="M7,8 H17 A5,5 0 0 1 21.8,14.4 L20.8,17.8 A2.4,2.4 0 0 1 16.8,18.8 L14.5,17 H9.5 L7.2,18.8 A2.4,2.4 0 0 1 3.2,17.8 L2.2,14.4 A5,5 0 0 1 7,8 Z"/>
              <TextBlock Text="Mando conectado" FontSize="13" Foreground="{StaticResource Brush.InkSoft}"/>
            </StackPanel>
          </Border>
          <Button x:Name="SoundButton" Style="{StaticResource Button.Round}" ToolTip="Sonido (M)" Margin="0,0,10,0">
            <Path x:Name="SoundIcon" Width="20" Height="20" Stretch="Uniform" Stroke="{StaticResource Brush.Ink}" StrokeThickness="1.8"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
          </Button>
          <TextBlock x:Name="Clock" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Brush.InkSoft}"
                     VerticalAlignment="Center" Margin="4,0,18,0" MinWidth="56" TextAlignment="Right"/>
          <Button x:Name="MinimizeButton" Style="{StaticResource Button.Round}" ToolTip="Minimizar" Margin="0,0,8,0">
            <Path Data="M5,12 H19" Width="16" Height="16" Stretch="Uniform" Stroke="{StaticResource Brush.Ink}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          </Button>
          <Button x:Name="CloseButton" Style="{StaticResource Button.Round}" ToolTip="Cerrar Nexo (Alt+F4)">
            <Path Data="M6,6 L18,18 M18,6 L6,18" Width="14" Height="14" Stretch="Uniform" Stroke="{StaticResource Brush.Ink}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          </Button>
        </StackPanel>
      </Grid>

      <!-- ================= Carrusel de consolas ================= -->
      <Grid Grid.Row="1" x:Name="StageArea">
        <Canvas x:Name="Stage" Background="Transparent" ClipToBounds="False" Cursor="Hand"/>
        <Button x:Name="PrevButton" Style="{StaticResource Button.Round}" Width="56" Height="56" HorizontalAlignment="Left"
                Margin="48,0,0,0" VerticalAlignment="Center" ToolTip="Consola anterior">
          <Path Data="M15,5 L8,12 L15,19" Width="22" Height="22" Stretch="Uniform" Stroke="{StaticResource Brush.Ink}" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
        </Button>
        <Button x:Name="NextButton" Style="{StaticResource Button.Round}" Width="56" Height="56" HorizontalAlignment="Right"
                Margin="0,0,48,0" VerticalAlignment="Center" ToolTip="Consola siguiente">
          <Path Data="M9,5 L16,12 L9,19" Width="22" Height="22" Stretch="Uniform" Stroke="{StaticResource Brush.Ink}" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
        </Button>
      </Grid>

      <!-- ================= Información de la consola ================= -->
      <StackPanel Grid.Row="2" x:Name="InfoPanel" HorizontalAlignment="Center" Margin="20,6,20,0">
        <StackPanel.RenderTransform><TranslateTransform x:Name="InfoMove"/></StackPanel.RenderTransform>
        <TextBlock x:Name="InfoSystem" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"
                   Foreground="{DynamicResource Brush.Accent}"/>
        <TextBlock x:Name="InfoName" FontSize="64" FontWeight="ExtraBold" HorizontalAlignment="Center" Margin="0,2,0,6"/>
        <TextBlock x:Name="InfoDescription" FontSize="16" TextWrapping="Wrap" MaxWidth="700" TextAlignment="Center"
                   HorizontalAlignment="Center" Foreground="{StaticResource Brush.InkSoft}" LineHeight="24"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
          <Border x:Name="StatusPill" CornerRadius="999" Padding="12,5" Background="{StaticResource Brush.Glass}"
                  BorderBrush="{StaticResource Brush.Line}" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="StatusDot" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                <Ellipse.Effect><DropShadowEffect x:Name="StatusGlow" BlurRadius="10" ShadowDepth="0" Opacity="0.9"/></Ellipse.Effect>
              </Ellipse>
              <TextBlock x:Name="StatusText" FontSize="13" FontWeight="SemiBold"/>
            </StackPanel>
          </Border>
          <TextBlock x:Name="StatusPath" FontFamily="{StaticResource Font.Mono}" FontSize="12.5" Margin="12,0,0,0"
                     Foreground="{StaticResource Brush.InkFaint}" VerticalAlignment="Center" MaxWidth="460" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <WrapPanel x:Name="Actions" HorizontalAlignment="Center" Margin="0,16,0,0">
          <Button x:Name="PrimaryButton" Style="{StaticResource Button.Primary}">
            <StackPanel Orientation="Horizontal">
              <Path x:Name="PrimaryIcon" Width="16" Height="16" Stretch="Uniform" Fill="White" Margin="0,0,10,0" Data="M8,5.5 V18.5 L19,12 Z"/>
              <TextBlock x:Name="PrimaryText" Text="Abrir emulador" Foreground="White"/>
              <Border Style="{StaticResource Kbd}" Margin="10,0,0,0" BorderBrush="#66FFFFFF">
                <TextBlock Text="Enter" FontSize="11.5" FontWeight="SemiBold" Foreground="White"/>
              </Border>
            </StackPanel>
          </Button>
          <Button x:Name="GamesFolderButton" Style="{StaticResource Button.Glass}">
            <StackPanel Orientation="Horizontal">
              <Path Width="17" Height="17" Stretch="Uniform" Stroke="{StaticResource Brush.Ink}" StrokeThickness="1.8" StrokeLineJoin="Round" Margin="0,0,10,0"
                    Data="M3,7 A2,2 0 0 1 5,5 H9 L11,7 H19 A2,2 0 0 1 21,9 V17 A2,2 0 0 1 19,19 H5 A2,2 0 0 1 3,17 Z"/>
              <TextBlock Text="Carpeta de juegos"/>
            </StackPanel>
          </Button>
          <Button x:Name="EmulatorFolderButton" Style="{StaticResource Button.Glass}">
            <StackPanel Orientation="Horizontal">
              <Path Width="17" Height="17" Stretch="Uniform" Stroke="{StaticResource Brush.Ink}" StrokeThickness="1.8" StrokeLineJoin="Round" Margin="0,0,10,0"
                    Data="M4,6 H20 V18 H4 Z M4,10 H20 M8,14 H12"/>
              <TextBlock Text="Carpeta del emulador"/>
            </StackPanel>
          </Button>
          <Button x:Name="LocateButton" Style="{StaticResource Button.Ghost}">
            <StackPanel Orientation="Horizontal">
              <Path Width="17" Height="17" Stretch="Uniform" Stroke="{StaticResource Brush.Ink}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,0,10,0"
                    Data="M11,4 A7,7 0 1 1 10.99,4 Z M16,16 L21,21"/>
              <TextBlock Text="Elegir ejecutable"/>
            </StackPanel>
          </Button>
          <Button x:Name="ImportButton" Style="{StaticResource Button.Glass}" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
              <Path Width="17" Height="17" Stretch="Uniform" Stroke="{StaticResource Brush.Ink}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Margin="0,0,10,0"
                    Data="M12,20 V9 M7,13 L12,8 L17,13 M5,4 H19"/>
              <TextBlock x:Name="ImportText" Text="Importar archivos"/>
            </StackPanel>
          </Button>
          <Button x:Name="WebsiteButton" Style="{StaticResource Button.Ghost}">
            <StackPanel Orientation="Horizontal">
              <Path Width="16" Height="16" Stretch="Uniform" Stroke="{StaticResource Brush.Ink}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Margin="0,0,10,0"
                    Data="M14,4 H20 V10 M20,4 L11,13 M18,14 V18 A2,2 0 0 1 16,20 H6 A2,2 0 0 1 4,18 V8 A2,2 0 0 1 6,6 H10"/>
              <TextBlock Text="Web oficial"/>
            </StackPanel>
          </Button>
        </WrapPanel>
      </StackPanel>

      <!-- ================= Estantería de juegos ================= -->
      <Grid Grid.Row="3" x:Name="ShelfArea" Height="250" Margin="0,14,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Margin="60,0,60,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
            <TextBlock x:Name="ShelfTitle" Text="Juegos" FontSize="20" FontWeight="Bold"/>
            <TextBlock x:Name="ShelfCount" FontSize="14" Margin="10,0,0,2" VerticalAlignment="Bottom" Foreground="{StaticResource Brush.InkFaint}"/>
          </StackPanel>
          <TextBlock x:Name="ShelfHint" HorizontalAlignment="Right" VerticalAlignment="Bottom" FontSize="13" Foreground="{StaticResource Brush.InkFaint}"/>
        </Grid>
        <Canvas Grid.Row="1" x:Name="Shelf" Background="Transparent" ClipToBounds="False" Margin="0,4,0,0"/>
        <Border Grid.Row="1" x:Name="ShelfEmpty" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                CornerRadius="20" Padding="28,18" Background="{StaticResource Brush.Glass}" BorderBrush="{StaticResource Brush.Line}" BorderThickness="1">
          <StackPanel>
            <TextBlock x:Name="ShelfEmptyTitle" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock x:Name="ShelfEmptyText" FontSize="14" Margin="0,6,0,0" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="560"
                       Foreground="{StaticResource Brush.InkSoft}"/>
          </StackPanel>
        </Border>
      </Grid>

      <!-- ================= Pie: puntos y atajos ================= -->
      <StackPanel Grid.Row="4" Margin="0,8,0,16" HorizontalAlignment="Center">
        <StackPanel x:Name="Dots" Orientation="Horizontal" HorizontalAlignment="Center"/>
        <StackPanel x:Name="Hints" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0" TextElement.FontSize="13"/>
      </StackPanel>
    </Grid>

    <!-- ================= Avisos ================= -->
    <Border x:Name="Toast" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,84,0,0" Opacity="0"
            CornerRadius="14" Padding="20,12" MaxWidth="620" Background="#D90E101A" BorderThickness="1" BorderBrush="{StaticResource Brush.Line}"
            IsHitTestVisible="False">
      <Border.RenderTransform><TranslateTransform x:Name="ToastMove" Y="-20"/></Border.RenderTransform>
      <Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="10" Direction="270" Opacity="0.6"/></Border.Effect>
      <TextBlock x:Name="ToastText" FontSize="14.5" TextWrapping="Wrap"/>
    </Border>
  </Grid>
</Window>
